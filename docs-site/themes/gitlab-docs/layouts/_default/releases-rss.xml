{{- partial "rss-release-data.html" . -}}
{{- $releases := .Scratch.Get "majorReleases" -}}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>GitLab Monthly Releases</title>
  <id>{{ .Site.BaseURL }}releases/</id>
  <link href="{{ .Site.BaseURL }}releases/" rel="alternate"/>
  <link href="{{ .Site.BaseURL }}releases/releases.xml" rel="self" type="application/atom+xml"/>
  {{- if gt (len $releases) 0 }}
  <updated>{{ (index $releases 0).date | dateFormat "2006-01-02T15:04:05Z07:00" }}</updated>
  {{- else }}
  <updated>{{ now | dateFormat "2006-01-02T15:04:05Z07:00" }}</updated>
  {{- end }}
  <author>
    <name>The GitLab Team</name>
  </author>
  {{- range $releases }}
  <entry>
    <title>{{ .title }}</title>
    <link href="{{ .link }}" rel="alternate"/>
    <id>{{ .id }}</id>
    <published>{{ .date | dateFormat "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ .date | dateFormat "2006-01-02T15:04:05Z07:00" }}</updated>
    <author>
      <name>{{ .author }}</name>
    </author>
    <content type="html"><![CDATA[{{ .content | replaceRE "]]>" "]]]]><![CDATA[>" | safeHTML }}]]></content>
  </entry>
  {{- end }}
</feed>
