    {
      "title": "Service Health Status",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "background",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "up{job=\"gitpulse-api\"}",
          "legendFormat": "API Server"
        },
        {
          "expr": "up{job=\"prometheus\"}",
          "legendFormat": "Prometheus"
        },
        {
          "expr": "up{job=\"grafana\"}",
          "legendFormat": "Grafana"
        },
        {
          "expr": "up{job=\"jaeger\"}",
          "legendFormat": "Jaeger Tracing"
        }
      ]
    },
