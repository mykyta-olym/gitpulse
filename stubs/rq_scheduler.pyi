from typing import Any

class Scheduler:
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def get_jobs(self) -> list[Any]: ...
    def cancel(self, job: Any) -> None: ...
    def schedule(self, *args: Any, **kwargs: Any) -> Any: ...
    def run(self, *args: Any, **kwargs: Any) -> None: ...
