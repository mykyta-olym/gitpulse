from collections.abc import Iterable
from typing import Any

class SimpleDocTemplate:
    def __init__(self, filename: Any, **kwargs: Any) -> None: ...
    def build(self, flowables: Iterable[Any], **kwargs: Any) -> None: ...

class Paragraph:
    def __init__(self, text: str, style: Any = ...) -> None: ...

class Spacer:
    def __init__(self, width: float, height: float) -> None: ...

class Table:
    def __init__(self, data: Any, **kwargs: Any) -> None: ...
    def setStyle(self, style: Any) -> None: ...

class TableStyle:
    def __init__(self, commands: Any) -> None: ...

class PageBreak:
    def __init__(self) -> None: ...
