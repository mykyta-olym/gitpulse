from typing import Any, Generic, TypeVar

T = TypeVar("T")

class ConnectionPool:
    def __init__(self, **kwargs: Any) -> None: ...
    @classmethod
    def from_url(cls, url: str, **kwargs: Any) -> ConnectionPool: ...
    def disconnect(self, inuse_connections: bool = ...) -> None: ...

class Redis(Generic[T]):
    def __init__(self, *, connection_pool: ConnectionPool | None = ..., **kwargs: Any) -> None: ...
    @classmethod
    def from_url(cls, url: str, **kwargs: Any) -> Redis[Any]: ...
    def pipeline(self) -> Any: ...
    def close(self) -> Any: ...
    def pubsub(self, **kwargs: Any) -> Any: ...
    def get(self, key: str) -> Any: ...
    def set(self, key: str, value: Any, **kwargs: Any) -> Any: ...
    def ping(self) -> Any: ...
    def delete(self, *keys: str) -> Any: ...
    def expire(self, key: str, seconds: int) -> Any: ...
    def setex(self, key: str, seconds: int, value: Any) -> Any: ...
    def scan(self, cursor: int, match: str | None = ..., count: int | None = ...) -> Any: ...
    def zcard(self, key: str) -> Any: ...
    def eval(self, script: str, numkeys: int, *keys_and_args: str) -> Any: ...
    def incr(self, key: str) -> Any: ...
    def ttl(self, key: str) -> Any: ...
    def llen(self, key: str) -> Any: ...
