from typing import Any, Generic, TypeVar

T = TypeVar("T")

class Redis(Generic[T]):
    @classmethod
    def from_url(cls, url: str, **kwargs: Any) -> Redis[Any]: ...
    async def ping(self) -> Any: ...
    async def info(self, section: str | None = ...) -> Any: ...
    async def close(self) -> Any: ...
    async def aclose(self) -> Any: ...
    async def get(self, key: str) -> Any: ...
    async def set(self, key: str, value: Any, **kwargs: Any) -> Any: ...
    async def delete(self, *keys: str) -> Any: ...
    async def expire(self, key: str, seconds: int) -> Any: ...
    async def setex(self, key: str, seconds: int, value: Any) -> Any: ...
    async def scan(self, cursor: int, match: str | None = ..., count: int | None = ...) -> Any: ...
    async def zcard(self, key: str) -> Any: ...
    async def eval(self, script: str, numkeys: int, *keys_and_args: str) -> Any: ...
    async def incr(self, key: str) -> Any: ...
    async def ttl(self, key: str) -> Any: ...
    async def llen(self, key: str) -> Any: ...
    def pipeline(self) -> Any: ...
