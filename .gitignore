# Runtime support-ticket attachments (created on first upload; never commit user files)
src/app/templates/static/uploads/

# Claude Code local settings: per-machine tool allowlists (the `.local` suffix
# is the convention for "not shared"), and this one had a dev secret inlined
# in a permission string.
.claude/settings.local.json
.claude/settings.local.json.bak

# `impeccable` (the UI anti-pattern detector) installs the same ~3.5 MB skill
# tree three times, once per agent runtime. It is a developer tool, not part of
# the app: install it with `npx impeccable install`. Its PROJECT decisions are
# committed - `.impeccable/config.json` and PRODUCT.md - so the audit is
# reproducible without vendoring the tool.
.claude/skills/impeccable/
.agents/skills/impeccable/
.codex/hooks.json

# `build/` above is unanchored, so it also swallowed docs-site/cmd/build/ and
# cmd/internal/build/ - GitLab's page-metadata generator. The deploy builds from
# the git checkout, so the sidebar fix built locally and failed on prod with
# `go run ./cmd/pagemeta` exit 1.
!docs-site/cmd/build/
!docs-site/cmd/internal/build/
